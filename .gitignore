# ==========================================
# 🌌 推荐系统课程大作业特定过滤 (Project Specific)
# ==========================================

# 1. 忽略庞大的原始和切分数据集
data/
**/data/

# 2. 忽略所有模型权重参数（防止上百 MB 文件被拒）
*.pt
results/*.pt
**/results/*.pt

# 3. 忽略评估测试结果 JSON/JS 文件及临时缓存
results/*.json
results/*.js
*_metrics.json
test_metrics.json

# 4. 忽略运行时日志与测试脚本
*.log
bpr_debug.log
test_sasrec_server.py

# 5. 忽略本地可视化大屏及其数据载体 (测试文件)
dashboard.html
results/dashboard_data.js

# 6. 忽略中英文实验报告及说明 (实验报告不需要上传)
实验报告.md
实验报告.docx
实验报告_已更新.docx
~$实验报告.docx
大作业说明.docx
大作业说明.pdf

# 7. 忽略临时本地开发与 IDE 配置文件
.deepseek/
.reasonix/
.idea/
.vscode/
*.pem
